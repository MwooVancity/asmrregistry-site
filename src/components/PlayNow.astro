---
// Guides whose readers want to press play (rain sounds for sleeping): long catalog videos that play in place,
// with the trigger's catalog numbers. From the build snapshot, no database read.
import hub from '../lib/hub-data-all.json';

interface Props { trigger: string; label: string }
const { trigger, label } = Astro.props;
const { triggerHubs, catalogStats, catalogDate } = hub as any;
const stat = catalogStats.find((s: any) => s.trigger === trigger);
const vids = (triggerHubs[trigger]?.videos ?? []).filter((v: any) => v.duration_seconds >= 3600).slice(0, 6);
const len = (s: number) => (s >= 3600 ? `${Math.floor(s / 3600)} h ${Math.round((s % 3600) / 60)} min` : `${Math.round(s / 60)} min`);
---
{vids.length >= 3 && stat && (
<section class="pn">
  <h2>Long {label} videos to play now</h2>
  <p>{`Our catalog lists ${stat.count.toLocaleString('en-US')} ${label} videos (${catalogDate}).`} The median one runs {stat.medianMin} minutes and {stat.over30}% run 30 minutes or longer. These are among the most watched that run over an hour; press play and they start here.</p>
  <div class="video-grid">
    {vids.map((v: any) => (
      <article class="video-card">
        <button type="button" class="vplay" data-v={v.id} aria-label={`Play ${v.title}`}>
          <div class="video-thumb">
            <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt={v.title} loading="lazy" width="320" height="180" />
            <span class="duration-badge">{len(v.duration_seconds)}</span>
          </div>
          <p class="vt">{v.title}</p>
        </button>
      </article>
    ))}
  </div>
  <p class="vplay-more">Want to mix {label} with other sounds and set a timer? Try the <a href="/tools/soundscape/">Soundscape mixer</a>.</p>
  <script src="/js/vplay.js" defer></script>
</section>
)}

<style>
  .pn { margin: 2rem 0; }
</style>
