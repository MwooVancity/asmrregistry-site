---
interface Props {
  items: Array<{ name: string; url: string }>;
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb">
  <ol class="breadcrumbs">
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? <a href={item.url}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
