---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found — ASMR Registry" description="This page doesn't exist." canonical="/404/" robots="noindex,nofollow">
  <div class="notice" style="margin:4rem 0;padding:3rem 2rem">
    <strong style="font-size:1.3rem">404 — Page not found</strong>
    <p style="margin:1rem 0 1.5rem;color:var(--text-2)">This page doesn't exist or may have been removed.</p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
      <a href="/" class="btn-outline">Browse ASMR</a>
      <a href="/asmr-videos/" class="btn-outline">Search Videos</a>
      <a href="/sleep/" class="btn-outline">Sleep ASMR</a>
      <a href="/triggers-overview/" class="btn-outline">All Triggers</a>
      <a href="/guides/" class="btn-outline">Guides</a>
    </div>
  </div>
</BaseLayout>
