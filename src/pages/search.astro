---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { search } from '../lib/search';
import { TRIGGER_GROUPS, VALID_INTENTS } from '../lib/constants';

const q = Astro.url.searchParams.get('q') || '';
const intent = Astro.url.searchParams.get('intent') || '';
const trigger = Astro.url.searchParams.get('trigger') || '';
const sort = (Astro.url.searchParams.get('sort') as any) || 'relevance';

const results = await search(q, {
  intent: intent || undefined,
  trigger: trigger || undefined,
  sort,
});

const allTriggers = [...new Set(Object.values(TRIGGER_GROUPS).flat())].sort();
const allIntents = [...VALID_INTENTS].sort();
const intentLabels: Record<string, string> = {
  sleep: 'Sleep', study: 'Study & Focus', relax: 'Relaxation', tingles: 'Tingles',
  anxiety: 'Anxiety Relief', insomnia: 'Insomnia', meditation: 'Meditation',
  background: 'Background', adhd: 'ADHD Focus', headache: 'Headache Relief',
  depression: 'Mood Support', kids: 'Kids', tinnitus: 'Tinnitus Relief',
};

const fmt = (n: number) => n >= 1e9 ? `${(n/1e9).toFixed(1)}B` : n >= 1e6 ? `${(n/1e6).toFixed(n >= 1e7 ? 0 : 1)}M` : n >= 1000 ? `${(n/1000).toFixed(n >= 10000 ? 0 : 1)}K` : String(n);
const durFmt = (s: number) => {
  if (!s) return '';
  const m = Math.floor(s / 60);
  return m >= 60 ? `${Math.floor(m/60)}h ${m%60}m` : `${m} min`;
};

Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');

const title = q ? `Search "${q}" — ASMR Registry` : 'Search ASMR Videos — ASMR Registry';
const desc = 'Search classified ASMR videos by trigger, intent, and duration. Find exactly the ASMR content you need.';

const SITE = 'https://asmrregistry.com';
const jsonLd = [
  {
    "@type": "SearchResultsPage",
    "@id": `${SITE}/search/#page`,
    "name": title,
    "url": `${SITE}/search/`,
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Search", "item": `${SITE}/search/` },
    ],
  },
];
---

<BaseLayout title={title} description={desc} canonical="/search/" jsonLd={jsonLd}>
  <h1>Search ASMR Videos</h1>
  <p class="search-intro">Filter by trigger type, use case, or search by keyword across all classified videos.</p>

  <form class="search-form" method="get" action="/search/">
    <div class="search-bar">
      <input type="text" name="q" value={q} placeholder="Search by keyword..." class="search-input" />
      <button type="submit" class="search-btn">Search</button>
    </div>
    <div class="filters">
      <select name="trigger" class="filter-select">
        <option value="">All triggers</option>
        {allTriggers.map(t => (
          <option value={t} selected={trigger === t}>{t.replace(/-/g, ' ')}</option>
        ))}
      </select>
      <select name="intent" class="filter-select">
        <option value="">All use cases</option>
        {allIntents.map(i => (
          <option value={i} selected={intent === i}>{intentLabels[i] || i}</option>
        ))}
      </select>
      <select name="sort" class="filter-select">
        <option value="relevance" selected={sort === 'relevance'}>Most Relevant</option>
        <option value="views" selected={sort === 'views'}>Most Viewed</option>
        <option value="date" selected={sort === 'date'}>Newest</option>
      </select>
    </div>
  </form>

  {results.length === 0 ? (
    <div class="no-results">
      <p>{q || intent || trigger ? 'No videos match your search. Try different filters.' : 'Enter a search term or select filters to find ASMR videos.'}</p>
    </div>
  ) : (
    <div class="results-meta">
      <span>{results.length} video{results.length !== 1 ? 's' : ''} found</span>
    </div>
  )}

  {results.length > 0 && (
    <div class="video-grid">
      {results.map(r => (
        <article class="video-card">
          <a href={`/video/${r.youtube_id}/`}>
            <div class="video-thumb">
              <img src={`https://i.ytimg.com/vi/${r.youtube_id}/mqdefault.jpg`}
                   alt={r.title} loading="lazy" width="320" height="180" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
            </div>
            <h3>{r.title}</h3>
          </a>
          <p class="meta">
            {r.creator_name}
            {r.authority_score ? ` · ${fmt(r.authority_score)} views` : ''}
          </p>
          {r.triggers.length > 0 && (
            <div class="tag-row">
              {r.triggers.slice(0, 3).map(t => (
                <a href={`/${t}/`} class="tag">{t.replace(/-/g, ' ')}</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  )}

  <section class="cross-section">
    <h2>Browse by category</h2>
    <div class="cross-links-row">
      <a href="/triggers-overview/" class="related-link">All Triggers →</a>
      <a href="/sleep/" class="related-link">Sleep ASMR →</a>
      <a href="/anxiety/" class="related-link">Anxiety Relief →</a>
      <a href="/guides/" class="related-link">ASMR Guides →</a>
      <a href="/best/" class="related-link">Best Of Lists →</a>
      <a href="/gear/" class="related-link">Gear Guides →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .search-intro { color: var(--text-2); margin: -0.5rem 0 1.5rem; }
  .search-form { margin: 0 0 1.5rem; }
  .search-bar { display: flex; gap: 0.5rem; margin: 0 0 0.75rem; }
  .search-input {
    flex: 1; padding: 0.75rem 1rem; background: var(--bg-2, #1a1a2e);
    border: 1px solid var(--border, #2a2a3e); border-radius: 8px;
    color: var(--text-1); font-size: 1rem;
  }
  .search-input:focus { outline: none; border-color: var(--accent, #7c3aed); }
  .search-btn {
    padding: 0.75rem 1.5rem; background: var(--accent, #7c3aed); color: #fff;
    border: none; border-radius: 8px; font-weight: 600; cursor: pointer;
    transition: opacity 0.15s;
  }
  .search-btn:hover { opacity: 0.9; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter-select {
    padding: 0.5rem 0.75rem; background: var(--bg-2, #1a1a2e);
    border: 1px solid var(--border, #2a2a3e); border-radius: 8px;
    color: var(--text-1); font-size: 0.9rem; text-transform: capitalize;
  }
  .no-results {
    padding: 3rem 2rem; text-align: center; color: var(--text-3, #888);
    background: var(--bg-2, #1a1a2e); border-radius: 8px;
  }
  .results-meta { color: var(--text-3, #888); font-size: 0.85rem; margin: 0 0 1rem; }
  .video-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;
  }
  .video-card {
    background: var(--bg-2, #1a1a2e); border: 1px solid var(--border, #2a2a3e);
    border-radius: 8px; overflow: hidden; transition: border-color 0.15s;
  }
  .video-card:hover { border-color: var(--accent, #7c3aed); }
  .video-card a { text-decoration: none; color: inherit; }
  .video-thumb { position: relative; }
  .video-thumb img { width: 100%; height: auto; display: block; }
  .video-card h3 {
    font-size: 0.9rem; font-weight: 500; margin: 0; padding: 0.75rem 0.75rem 0;
    line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }
  .meta { font-size: 0.8rem; color: var(--text-3, #888); padding: 0.25rem 0.75rem; margin: 0; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 0.3rem; padding: 0.5rem 0.75rem 0.75rem; }
  .tag {
    padding: 0.2rem 0.5rem; background: var(--bg-3, #12121f);
    border: 1px solid var(--border, #2a2a3e); border-radius: 999px;
    font-size: 0.72rem; color: var(--text-3, #888); text-decoration: none;
    text-transform: capitalize; transition: color 0.15s;
  }
  .tag:hover { color: var(--accent, #7c3aed); }
  .cross-section { margin: 2.5rem 0 0; }
  .cross-section h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
  .cross-links-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .related-link {
    padding: 0.5rem 1rem; background: var(--bg-2, #1a1a2e);
    border: 1px solid var(--border, #2a2a3e); border-radius: 999px;
    text-decoration: none; color: var(--accent, #7c3aed); font-size: 0.9rem;
    transition: background 0.15s;
  }
  .related-link:hover { background: var(--bg-3, #12121f); }
  @media (max-width: 640px) {
    .search-bar { flex-direction: column; }
    .filters { flex-direction: column; }
    .filter-select { width: 100%; }
  }
</style>
