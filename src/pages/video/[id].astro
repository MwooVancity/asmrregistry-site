---
// src/pages/video/[id].astro
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { deriveVideoFaqs } from '../../lib/video-faqs';
import { getDb } from '../../lib/db';
import { deriveSessionGuide } from '../../lib/video-insights';
import { getSimilarVideos } from '../../lib/similar-videos';

const { id } = Astro.params;
let db: any;
let video: any;
try {
  db = getDb();
  const result = await db.execute({ sql: `SELECT * FROM videos WHERE id = ?`, args: [id] });
  // 410 Gone (not 404) — tells Google the page is permanently removed, deindexes faster
  if (result.rows.length === 0) return new Response(null, { status: 410 });
  video = result.rows[0];
} catch {
  return new Response('Service temporarily unavailable', { status: 503, headers: { 'Retry-After': '60' } });
}

const intents: string[] = JSON.parse((video.intents as string) || '[]');
const triggers: string[] = JSON.parse((video.triggers as string) || '[]');
const modifiers: string[] = JSON.parse((video.modifiers as string) || '[]');
const parentSlug = video.primary_trigger ? `/${video.primary_trigger}/` : `/${intents[0] || ''}/`;
const parentLabel = video.primary_trigger
  ? `${(video.primary_trigger as string).replace(/-/g, ' ')} ASMR`
  : 'Browse ASMR';

const durationSec = (video.duration_seconds as number) || 0;
const durationMin = Math.floor(durationSec / 60);
const durationStr = durationMin >= 60
  ? `${Math.floor(durationMin/60)}h ${durationMin % 60 > 0 ? `${durationMin % 60}m` : ''}`
  : `${durationMin}m`;
const views = (video.view_count as number ?? 0).toLocaleString();

// ISO 8601 duration for schema (e.g. PT4H0M0S, not PT14400S)
const isoH = Math.floor(durationSec / 3600);
const isoM = Math.floor((durationSec % 3600) / 60);
const isoS = durationSec % 60;
const isoDuration = `PT${isoH}H${isoM}M${isoS}S`;

// Duration context
const durationContext = durationSec >= 28800 ? 'Overnight session — set it and sleep.'
  : durationSec >= 14400 ? 'Extended session — ideal for deep sleep or long study blocks.'
  : durationSec >= 3600 ? 'Long-form session — great for sleep or extended relaxation.'
  : durationSec >= 1800 ? 'Medium session — enough for a full wind-down.'
  : durationSec >= 600 ? 'Quick session — a focused tingle break.'
  : 'Short clip.';

// Format label
const formatLabel = video.format === 'roleplay' ? 'Roleplay'
  : video.format === 'ambient' ? 'Ambient'
  : video.format === 'compilation' ? 'Compilation'
  : video.format === 'asmr-with-music' ? 'ASMR + Music'
  : video.format ? String(video.format).replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
  : null;

// Intensity display
const intensity = video.intensity as number | null;

// Similar videos — same primary trigger + first intent, exclude self
let similarVideos: any[] = [];
if (video.primary_trigger) {
  similarVideos = getSimilarVideos(video.primary_trigger as string, id);
}

// Per-video session guide — unique bullets from this video's metadata combo
const sessionGuide = video.primary_trigger ? deriveSessionGuide({
  durationMin: Math.floor(((video.duration_seconds as number) || 0) / 60),
  intensity: video.intensity as number | null,
  format: video.format as string | null,
  primaryTrigger: video.primary_trigger as string,
  triggers,
  intents,
}) : [];

// Per-video FAQs — data-derived from trigger_stats (evil-Google mandate 4)
let videoFaqs: { q: string; a: string }[] = [];
let triggerVideoCount = 0;
try {
  if (video.primary_trigger) {
    const stats = await db.execute({
      sql: `SELECT video_count, co_occurrence FROM trigger_stats WHERE trigger_slug = ?`,
      args: [video.primary_trigger],
    });
    const statRow = stats.rows[0];
    triggerVideoCount = statRow ? Number(statRow.video_count ?? 0) : 0;
    videoFaqs = deriveVideoFaqs({
      triggerLabel: (video.primary_trigger as string).replace(/-/g, ' '),
      intentLabels: intents,
      durationMin: Math.floor(((video.duration_seconds as number) || 0) / 60),
      intensity: video.intensity as number | null,
      coOccurrence: statRow ? JSON.parse((statRow.co_occurrence as string) || '[]') : [],
      triggerVideoCount,
    });
  }
} catch {}

// Intensity rank removed: its per-view COUNT scan over a trigger cost ~6M D1 row reads/day and exhausted the free tier.
const intensityRank: { rank: number; total: number } | null = null;

// Index published videos that have at least a primary trigger or intents (99.9% of them).
// The 45 with neither get noindex — bare embed with no classification is indefensible to Google.
const indexable = true; // owner 2026-11-15: index every video page (ASMR Index model); was noindex

// Build classification-first title/H1/desc (targets queries a directory can win; YouTube title stays in meta desc for recognition)
const triggerLabel = video.primary_trigger ? (video.primary_trigger as string).replace(/-/g, ' ') : 'ASMR';
const intentLabel = intents[0] ? intents[0].replace(/-/g, ' ') : '';
const pageTriggerCap = triggerLabel.replace(/\b\w/g, (c: string) => c.toUpperCase());
const pageIntentCap = intentLabel.replace(/\b\w/g, (c: string) => c.toUpperCase());
const creatorShort = (video.channel_name as string || '').replace(/\s*ASMR\s*/gi, '').trim();
const pageTitle = intentLabel
  ? `${pageTriggerCap} ASMR for ${pageIntentCap} — ${durationStr} by ${creatorShort} | ASMR Registry`
  : `${pageTriggerCap} ASMR — ${durationStr} by ${creatorShort} | ASMR Registry`;
const pageH1 = intentLabel
  ? `${pageTriggerCap} ASMR for ${pageIntentCap} — ${durationStr}`
  : `${pageTriggerCap} ASMR — ${durationStr}`;
const rawTitle = video.title as string;
const titleSnippet = rawTitle.length > 45 ? rawTitle.slice(0, 44) + '…' : rawTitle;
const metaDesc = intentLabel
  ? `${pageTriggerCap} ASMR for ${pageIntentCap} — ${durationStr}. "${titleSnippet}" by ${video.channel_name}.`
  : `${pageTriggerCap} ASMR — ${durationStr}. "${titleSnippet}" by ${video.channel_name}.`;

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');

const jsonLd = [{
  "@context": "https://schema.org", "@type": "VideoObject",
  "@id": `https://asmrregistry.com/video/${id}/#video`,
  "name": video.title,
  "description": metaDesc,
  "thumbnailUrl": `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
  "uploadDate": video.publish_date || undefined,
  "dateModified": video.last_synchronized || video.publish_date,
  "duration": isoDuration,
  "contentUrl": `https://www.youtube.com/watch?v=${id}`,
  "embedUrl": `https://www.youtube-nocookie.com/embed/${id}`,
  "interactionStatistic": {
    "@type": "InteractionCounter",
    "interactionType": { "@type": "WatchAction" },
    "userInteractionCount": video.view_count ?? 0,
  },
}];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  ...(intents[0] ? [{ name: `${intents[0].replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())} ASMR`, url: `/${intents[0]}/` }] : []),
  ...(intents[0] && video.primary_trigger ? [{ name: `${triggerLabel.replace(/\b\w/g, (c: string) => c.toUpperCase())}`, url: parentSlug }] : []),
  { name: video.title as string, url: `/video/${id}/` },
];
jsonLd.push({
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, i) => ({ "@type": "ListItem", "position": i + 1, "name": b.name, "item": `https://asmrregistry.com${b.url}` })),
} as any);
// FAQPage only when the Q&As are visibly rendered below (law line)
if (videoFaqs.length >= 3) {
  jsonLd.push({
    "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": videoFaqs.map(f => ({
      "@type": "Question", "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  } as any);
}
---

<BaseLayout
  title={pageTitle}
  description={metaDesc}
  canonical={`/video/${id}/`}
  ogImage={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
  jsonLd={jsonLd}
  robots={indexable ? undefined : 'noindex,follow'}
>
  <nav aria-label="Breadcrumb">
    <ol class="breadcrumbs">
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <a href={b.url}>{b.name}</a>
            : <span aria-current="page">{(b.name as string).length > 50 ? (b.name as string).slice(0, 47) + '...' : b.name}</span>
          }
        </li>
      ))}
    </ol>
  </nav>

  <h1 style="font-size:clamp(1.3rem,3vw,1.9rem);margin-bottom:0.75rem">{pageH1}</h1>

  <div class="video-meta">
    <span>{video.channel_name}</span>
    {durationMin > 0 && <span>{durationStr}</span>}
    {(video.view_count as number) > 0 && <span>{views} views</span>}
  </div>

  <div class="video-player">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1`}
      title={video.title as string}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="eager"
    ></iframe>
  </div>

  {/* Why watch — editorial note from AI enrichment */}
  {video.why_watch && (
    <div class="why-watch">
      <h2>Why watch this</h2>
      <p>{video.why_watch}</p>
    </div>
  )}

  <!-- Classification data panel -->
  <div class="data-panel">
    <h2>Classification</h2>
    <div class="data-stats">
      {video.primary_trigger && (
        <div class="data-stat">
          <span class="value">{triggerLabel.replace(/\b\w/g, (c: string) => c.toUpperCase())}</span>
          <span class="label">primary trigger</span>
        </div>
      )}
      {intensity && (
        <div class="data-stat">
          <span class="value">{intensity}/5</span>
          <span class="label">intensity</span>
        </div>
      )}
      {intensityRank && (
        <div class="data-stat">
          <span class="value">#{intensityRank.rank} of {intensityRank.total}</span>
          <span class="label">{triggerLabel} by intensity</span>
        </div>
      )}
      {triggerVideoCount > 1 && (
        <div class="data-stat">
          <span class="value">{triggerVideoCount}</span>
          <span class="label">{triggerLabel} videos indexed</span>
        </div>
      )}
      {intents.length > 1 && (
        <div class="data-stat">
          <span class="value">{intents.length}</span>
          <span class="label">use cases covered</span>
        </div>
      )}
      {formatLabel && (
        <div class="data-stat">
          <span class="value">{formatLabel}</span>
          <span class="label">format</span>
        </div>
      )}
      {video.duration_bucket && (
        <div class="data-stat">
          <span class="value">{video.duration_bucket}</span>
          <span class="label">duration</span>
        </div>
      )}
    </div>
    <p style="font-size:0.85rem;color:var(--text-3);margin:1rem 0 0">{durationContext}</p>
  </div>

  {/* Per-video session guide — data-driven, unique per video's metadata combo */}
  {sessionGuide.length > 0 && (
    <div class="content-section">
      <h2>How to use this session</h2>
      <ul class="session-guide">
        {sessionGuide.map(bullet => (
          <li>{bullet}</li>
        ))}
      </ul>
    </div>
  )}

  {/* Data-derived FAQs — visible twin of the FAQPage schema */}
  {videoFaqs.length >= 3 && <FaqBlock faqs={videoFaqs} />}

  <!-- Trigger + Intent tags -->
  <div class="cross-links" style="margin-top:1.5rem">
    {intents.length > 0 && (
      <>
        <h3>Use cases</h3>
        <ul class="tag-list">
          {intents.map(intent => (
            <li><a href={`/${intent}/`}>{intent.replace(/-/g, ' ')} ASMR</a></li>
          ))}
        </ul>
      </>
    )}
  </div>

  {triggers.length > 0 && (
    <div class="cross-links" style="margin-top:1rem">
      <h3>Triggers in this video</h3>
      <ul class="tag-list">
        {triggers.map(trigger => (
          <li><a href={`/${trigger}/`}>{trigger.replace(/-/g, ' ')}</a></li>
        ))}
      </ul>
    </div>
  )}

  {modifiers.length > 0 && (
    <div class="cross-links" style="margin-top:1rem">
      <h3>Features</h3>
      <ul class="tag-list" style="pointer-events:none">
        {modifiers.map(mod => (
          <li><span style="display:inline-block;padding:0.375rem 0.875rem;background:var(--bg-3);color:var(--text-2);border:1px solid var(--border);border-radius:999px;font-size:0.82rem;font-weight:500">{mod.replace(/-/g, ' ')}</span></li>
        ))}
      </ul>
    </div>
  )}

  {video.roleplay_scenario && (
    <div style="margin-top:1rem;font-size:0.85rem;color:var(--text-3)">
      Roleplay: <strong style="color:var(--text-2)">{(video.roleplay_scenario as string).replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}</strong>
    </div>
  )}

  {parentSlug && intents[0] && video.primary_trigger && (
    <div class="browse-cta">
      <a href={parentSlug} class="btn-browse">
        Browse all {pageTriggerCap} ASMR for {pageIntentCap} →
      </a>
    </div>
  )}

  {video.primary_trigger && (
    <div class="cross-links" style="margin-top:1rem">
      <h3>Explore</h3>
      <ul class="tag-list">
        <li><a href={`/${video.primary_trigger}/`}>{triggerLabel.replace(/\b\w/g, (c: string) => c.toUpperCase())} Hub</a></li>
        <li><a href="/triggers-overview/">All Triggers</a></li>
        <li><a href="/asmr-videos/">Search Videos</a></li>
        <li><a href="/guides/">ASMR Guides</a></li>
        <li><a href="/best/">Best Of Lists</a></li>
        <li><a href="/gear/">Gear Guides</a></li>
      </ul>
    </div>
  )}

  <!-- Similar videos -->
  {similarVideos.length > 0 && (
    <div style="margin-top:2.5rem">
      <div class="section-label">Popular {triggerLabel} ASMR</div>
      <div class="video-grid">
        {similarVideos.map((v: any) => (
          <article class="video-card">
            <a href={`/video/${v.id}/`}>
              <div class="video-thumb">
                <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt={v.title} loading="lazy" width="320" height="180" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
                <div class="play-btn"><div class="play-btn-inner"></div></div>
              </div>
              <h3>{v.title}</h3>
            </a>
            <p class="meta">{v.channel_name ? `${v.channel_name} · ` : ''}{Math.floor((v.duration_seconds ?? 0) / 60)} min · {(v.view_count ?? 0).toLocaleString()} views</p>
          </article>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

<style>
  .browse-cta {
    margin: 1.5rem 0;
    display: flex;
    justify-content: flex-start;
  }
  .btn-browse {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn-browse:hover {
    background: var(--bg-3);
  }
  .content-section {
    margin: 1.5rem 0;
  }
  .content-section h2 {
    font-size: 1.05rem;
    margin: 0 0 0.75rem;
    color: var(--text-1, #fff);
  }
  .session-guide {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .session-guide li {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-2, #ccc);
    padding: 0.375rem 0 0.375rem 1.25rem;
    position: relative;
  }
  .session-guide li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent, #7c3aed);
  }
  .why-watch {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: var(--bg-2, #1a1a2e);
    border: 1px solid var(--border, #2a2a3e);
    border-left: 3px solid var(--accent, #7c3aed);
    border-radius: 8px;
  }
  .why-watch h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-3, #888);
    margin: 0 0 0.5rem;
  }
  .why-watch p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-1, #fff);
    margin: 0;
  }
</style>
