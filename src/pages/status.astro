---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb } from '../lib/db';
// Off in production: one view runs a dozen full-table scans, and a robots.txt line does not stop anyone.
if (import.meta.env.PROD) return new Response(null, { status: 404 });

let totalPublished = 0;
let totalQueued = 0;
let totalChannels = 0;
let totalHubs = 0;
let lastSync = '';
let publishedToday = 0;
let staleRate = 0;
let staleCount = 0;
let authorityAvg = 0;

interface Flag { level: 'red' | 'yellow' | 'green'; title: string; detail: string; }
const flags: Flag[] = [];

try {
  const db = getDb();
  const today = new Date().toISOString().slice(0, 10);

  totalPublished = Number((await db.execute(`SELECT COUNT(*) as c FROM videos WHERE status='published'`)).rows[0]?.c ?? 0);
  totalQueued = Number((await db.execute(`SELECT COUNT(*) as c FROM ingest_queue`)).rows[0]?.c ?? 0);
  totalChannels = Number((await db.execute(`SELECT COUNT(*) as c FROM channels`)).rows[0]?.c ?? 0);

  // hubs table may not exist in live DB — default to 0
  try {
    totalHubs = Number((await db.execute(`SELECT COUNT(*) as c FROM hubs`)).rows[0]?.c ?? 0);
  } catch { totalHubs = 0; }

  const syncData = await db.execute(`SELECT MAX(last_synchronized) as last_sync FROM videos WHERE status='published'`);
  lastSync = syncData.rows[0]?.last_sync ? new Date(syncData.rows[0].last_sync as string).toLocaleString() : 'Never';

  publishedToday = Number((await db.execute({
    sql: `SELECT COUNT(*) as c FROM videos WHERE status='published' AND last_synchronized >= datetime('now', '-1 day')`,
    args: []
  })).rows[0]?.c ?? 0);

  // availability_last_checked column not in live DB — default stale count to 0
  staleCount = 0;
  staleRate = 0;

  // channels table has no authority_score — leave authorityAvg at 0
  authorityAvg = 0;
} catch (e) {
  console.error('Status page error:', e);
}

// Kill-switch checks
if (staleRate > 0.1) {
  flags.push({ level: 'red', title: '🚨 HIGH STALE RATE', detail: `${(staleRate*100).toFixed(1)}% of videos are stale (deleted/unavailable). Check YouTube availability.` });
}

if (totalQueued > 5000) {
  flags.push({ level: 'yellow', title: '⚠️ QUEUE BACKING UP', detail: `${totalQueued.toLocaleString()} videos in ingest queue. Enrichment may be falling behind.` });
}

if (totalPublished === 0) {
  flags.push({ level: 'yellow', title: '⏳ COLD START', detail: `No published videos yet. Ingest pipeline running, waiting for first videos to pass gates.` });
}

if (totalPublished > 500) {
  flags.push({ level: 'green', title: '💰 ADSENSE ELIGIBLE', detail: `${totalPublished} videos + ${totalHubs} hubs = eligible for AdSense. Apply at google.com/adsense.` });
}

interface Month { label: string; videos: number; hubs: number; visitors: number; revenue: number; }
const months: Month[] = [];
let cumVideos = totalPublished;
let cumHubs = Math.max(totalHubs, 1);

for (let m = 0; m <= 12; m++) {
  const date = new Date();
  date.setMonth(date.getMonth() + m);
  const label = date.toLocaleString('en-US', { month: 'short', year: 'numeric' });

  const dailyCap = Math.min(Math.round(50 * Math.pow(1.08, m)), 150);
  const newVideos = dailyCap * 30;
  cumVideos = Math.round(cumVideos + newVideos);
  cumHubs = Math.min(cumHubs + Math.floor(newVideos / 10), 200);

  const seoMonths = Math.max(0, m - 2);
  const visitors = Math.round(cumHubs * 200 * Math.pow(1.15, seoMonths));
  const revenue = Math.round((visitors / 1000) * 2.5);

  months.push({ label, videos: cumVideos, hubs: cumHubs, visitors, revenue });
}

const fmt = (n: number) => n >= 1e9 ? `${(n/1e9).toFixed(1)}B` : n >= 1e6 ? `${(n/1e6).toFixed(n >= 1e7 ? 0 : 1)}M` : n >= 1000 ? `${(n/1000).toFixed(n >= 10000 ? 0 : 1)}K` : String(n);
---

<BaseLayout
  title="ASMR Registry — Pipeline Status"
  description="Live ingest and growth metrics."
  canonical="/status"
  robots="noindex,nofollow"
>

{flags.length > 0 && (
  <div style="margin-bottom:2rem;display:flex;flex-direction:column;gap:0.75rem">
    {flags.map(f => (
      <div style={`border-radius:10px;padding:1.25rem;border:2px solid ${f.level==='red'?'#ef4444':f.level==='green'?'#22c55e':'#f59e0b'};background:${f.level==='red'?'rgba(239,68,68,0.08)':f.level==='green'?'rgba(34,197,94,0.08)':'rgba(245,158,11,0.08)'}`}>
        <div style={`font-weight:800;margin-bottom:0.5rem;color:${f.level==='red'?'#ef4444':f.level==='green'?'#22c55e':'#f59e0b'}`}>{f.title}</div>
        <div style="font-size:0.875rem;color:var(--text-2)">{f.detail}</div>
      </div>
    ))}
  </div>
)}

<h1 style="margin-bottom:1.5rem">Pipeline Status</h1>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;margin-bottom:2.5rem">
  {[
    { label: 'Published', value: fmt(totalPublished) },
    { label: 'In Queue', value: fmt(totalQueued) },
    { label: 'Channels', value: fmt(totalChannels) },
    { label: 'Hubs', value: String(totalHubs) },
    { label: 'Avg Authority', value: authorityAvg.toFixed(1) },
    { label: 'Last Sync', value: lastSync.split(' ')[0] },
  ].map(s => (
    <div style="border:1px solid var(--border);border-radius:8px;padding:1rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">{s.value}</div>
      <div style="font-size:0.75rem;color:var(--text-3);margin-top:0.25rem">{s.label}</div>
    </div>
  ))}
</div>

<h2 style="font-size:1.2rem;margin:2rem 0 1rem">12-Month Projection</h2>
<p style="font-size:0.85rem;color:var(--text-3);margin-bottom:1rem">50/day publishing cap (+8%/month, max 150/day). 8-week SEO lag. $2.50 RPM.</p>

<div style="overflow-x:auto;margin-bottom:2rem">
  <table style="width:100%;border-collapse:collapse;font-size:0.875rem">
    <thead>
      <tr style="border-bottom:1px solid var(--border)">
        <th style="padding:0.6rem;text-align:left;color:var(--text-3)">Month</th>
        <th style="padding:0.6rem;text-align:right;color:var(--text-3)">Videos</th>
        <th style="padding:0.6rem;text-align:right;color:var(--text-3)">Hubs</th>
        <th style="padding:0.6rem;text-align:right;color:var(--text-3)">Monthly Visitors</th>
        <th style="padding:0.6rem;text-align:right;color:var(--text-3)">Revenue</th>
      </tr>
    </thead>
    <tbody>
      {months.map((m, i) => (
        <tr style={`border-bottom:1px solid var(--border);${i===0?'background:rgba(124,106,247,0.1)':''}`}>
          <td style="padding:0.6rem;color:var(--text-1);font-weight:500">{m.label}</td>
          <td style="padding:0.6rem;text-align:right;color:var(--text-2)">{fmt(m.videos)}</td>
          <td style="padding:0.6rem;text-align:right;color:var(--text-2)">{m.hubs}</td>
          <td style="padding:0.6rem;text-align:right;color:var(--text-2)">{m.visitors > 0 ? fmt(m.visitors) : '—'}</td>
          <td style={`padding:0.6rem;text-align:right;font-weight:600;color:${m.revenue >= 1000 ? '#22c55e' : 'var(--text-2)'}`}>
            {m.revenue > 0 ? `$${fmt(m.revenue)}` : '—'}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p style="font-size:0.8rem;color:var(--text-3)">Last updated: {new Date().toLocaleString()}</p>

</BaseLayout>
